{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dispatcher.local/native-interaction-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "observedAt",
    "rows"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "observedAt": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "product",
          "region",
          "profileId",
          "backendId",
          "installedVersion",
          "nativeStoreRef",
          "scopeFingerprint",
          "capabilities",
          "surfaces",
          "nextVerification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "profileId": {
            "type": "string",
            "minLength": 1
          },
          "backendId": {
            "type": "string",
            "minLength": 1
          },
          "installedVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "nativeStoreRef": {
            "type": "string",
            "minLength": 1
          },
          "scopeFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "durableIdentity",
              "historyRead",
              "sameSessionContinue",
              "liveSteer",
              "interruptTurn",
              "nativeApproval",
              "observeExternalChanges",
              "releaseControl",
              "reclaimControl",
              "restartReattach"
            ],
            "properties": {
              "durableIdentity": {
                "$ref": "#/$defs/evidence"
              },
              "historyRead": {
                "$ref": "#/$defs/evidence"
              },
              "sameSessionContinue": {
                "$ref": "#/$defs/evidence"
              },
              "liveSteer": {
                "$ref": "#/$defs/evidence"
              },
              "interruptTurn": {
                "$ref": "#/$defs/evidence"
              },
              "nativeApproval": {
                "$ref": "#/$defs/evidence"
              },
              "observeExternalChanges": {
                "$ref": "#/$defs/evidence"
              },
              "releaseControl": {
                "$ref": "#/$defs/evidence"
              },
              "reclaimControl": {
                "$ref": "#/$defs/evidence"
              },
              "restartReattach": {
                "$ref": "#/$defs/evidence"
              }
            }
          },
          "surfaces": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "desktop": {
                "$ref": "#/$defs/evidence"
              },
              "ide": {
                "$ref": "#/$defs/evidence"
              },
              "web": {
                "$ref": "#/$defs/evidence"
              },
              "mobile": {
                "$ref": "#/$defs/evidence"
              },
              "tui": {
                "$ref": "#/$defs/evidence"
              }
            }
          },
          "nextVerification": {
            "type": "string",
            "minLength": 20
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "durableIdentity": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "historyRead": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "sameSessionContinue": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "liveSteer": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "interruptTurn": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "nativeApproval": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "observeExternalChanges": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "releaseControl": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "reclaimControl": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "properties": {
                    "capabilities": {
                      "properties": {
                        "restartReattach": {
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                },
                {
                  "type": "object",
                  "properties": {
                    "surfaces": {
                      "type": "object",
                      "required": [
                        "desktop"
                      ],
                      "properties": {
                        "desktop": {
                          "type": "object",
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "surfaces": {
                      "type": "object",
                      "required": [
                        "ide"
                      ],
                      "properties": {
                        "ide": {
                          "type": "object",
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "surfaces": {
                      "type": "object",
                      "required": [
                        "web"
                      ],
                      "properties": {
                        "web": {
                          "type": "object",
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "surfaces": {
                      "type": "object",
                      "required": [
                        "mobile"
                      ],
                      "properties": {
                        "mobile": {
                          "type": "object",
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "surfaces": {
                      "type": "object",
                      "required": [
                        "tui"
                      ],
                      "properties": {
                        "tui": {
                          "type": "object",
                          "properties": {
                            "support": {
                              "const": "supported"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            },
            "then": {
              "properties": {
                "installedVersion": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "type": "object"
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "support",
        "level",
        "scopeFingerprint",
        "reasonCode"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "support": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "level": {
          "enum": [
            "documented",
            "installed-probed",
            "runtime-verified",
            "ui-roundtrip-verified"
          ]
        },
        "scopeFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "verifiedAt": {
          "type": "string",
          "minLength": 20
        },
        "evidenceRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "support": {
                "const": "supported"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "verifiedAt",
              "evidenceRef"
            ],
            "type": "object",
            "properties": {
              "verifiedAt": {
                "type": "string",
                "minLength": 20
              },
              "evidenceRef": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
