{
  "name": "agent-dispatcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test",
    "dev": "pnpm --filter @dispatcher/controller dev -- --with-runner",
    "dispatcher": "pnpm --filter @dispatcher/controller dispatcher",
    "benchmark": "node benchmarks/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
